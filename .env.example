# Muhammad Shafi Tanneries (MST) - Environment Configuration Template
# Copy this file to .env.local to configure local development or deployment settings.

# -------------------------------------------------------------
# Contact Form & Inbound Email Delivery
# -------------------------------------------------------------
# Optional custom API or Formspree endpoint (e.g., https://formspree.io/f/xyz123)
# If omitted or left blank, ContactPage uses FormSubmit AJAX fallback (sales.mst@shafi.com)
VITE_CONTACT_FORM_ENDPOINT=

# -------------------------------------------------------------
# Website Analytics & Conversion Tracking
# -------------------------------------------------------------
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Keep blank until official management-authorized GA4 property is created.
VITE_GA_MEASUREMENT_ID=

# Google Tag Manager Container ID (format: GTM-XXXXXXX)
# Keep blank if using GA4 direct measurement.
VITE_GTM_CONTAINER_ID=
